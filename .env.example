# Painter configuration — copy to .env and adjust.
# Never commit a filled-in .env: it holds credentials.

# ---------------------------------------------------------------- storage
PAINTER_DATA_DIR=./data
PAINTER_MODEL_DIR=./yolo_demo
PAINTER_MAX_UPLOAD_MB=25
PAINTER_MAX_PAGES=20
PAINTER_MAX_PAGE_PIXELS=12000000
PAINTER_TARGET_DPI=200
PAINTER_LOG_LEVEL=INFO
# Optional bearer token. When set, every /api route requires it.
# PAINTER_API_TOKEN=
PAINTER_JOB_WORKERS=2

# ---------------------------------------------------------------- detection
PAINTER_ENABLE_YOLO=true
# Layout model: any Ultralytics-compatible checkpoint. The bundled
# doclayout.pt is a DocLayout-YOLO (YOLOv10) checkpoint and is loaded through
# the doclayout_yolo runtime automatically.
PAINTER_LAYOUT_MODEL=doclayout.pt
PAINTER_COCO_MODEL=yolov8n.pt
# Purpose-trained Painter model (see docs/DATASET.md). Used when present.
PAINTER_CUSTOM_MODEL=painter_doclayout.pt
PAINTER_YOLO_CONF=0.25
PAINTER_YOLO_IOU=0.45
PAINTER_YOLO_IMGSZ=1024
# cpu | cuda:0 | mps  (leave empty for auto)
PAINTER_YOLO_DEVICE=

# ---------------------------------------------------------------- OCR
# auto | tesseract | lens | none
PAINTER_OCR_PROVIDER=auto
PAINTER_TESSERACT_LANG=eng
PAINTER_OCR_UPSCALE=true

# ---------------------------------------------------------------- SerpApi (Google Lens)
# The key is read ONLY from the environment. Never hardcode it in source.
# SERPAPI_KEY=
PAINTER_ENABLE_SERPAPI=false
PAINTER_SERPAPI_BASE_URL=https://serpapi.com
PAINTER_SERPAPI_TIMEOUT_S=30
PAINTER_SERPAPI_CONNECT_TIMEOUT_S=10
PAINTER_SERPAPI_MAX_RETRIES=3
PAINTER_SERPAPI_BACKOFF_BASE_S=1.5
PAINTER_SERPAPI_BACKOFF_MAX_S=20
# Request budget: protects against runaway credit usage.
PAINTER_SERPAPI_MAX_REQUESTS_PER_DOC=30
PAINTER_SERPAPI_MAX_REQUESTS_TOTAL=400
PAINTER_SERPAPI_CACHE=true
PAINTER_SERPAPI_UPLOAD_MAX_BYTES=480000
PAINTER_SERPAPI_SEARCH_MAX_BYTES=900
PAINTER_SERPAPI_LENS_TYPE=all

# ---------------------------------------------------------------- assets
# Downloading a matched image is opt-in: it fetches data from third parties.
PAINTER_ENABLE_ASSET_DOWNLOAD=false
PAINTER_ASSET_MAX_BYTES=8000000
PAINTER_ASSET_MATCH_THRESHOLD=0.72

# ---------------------------------------------------------------- verification
PAINTER_VERIFY=true
PAINTER_VERIFY_TARGET=0.93
PAINTER_VERIFY_MAX_ITERATIONS=3
PAINTER_VERIFY_MIN_IMPROVEMENT=0.004
PAINTER_RASTERIZE_DPI=150

# ---------------------------------------------------------------- optional LLM
PAINTER_ENABLE_LLM=false
PAINTER_LLM_MODEL=gpt-4o-mini
PAINTER_LLM_TIMEOUT_S=60
